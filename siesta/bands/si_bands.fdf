SystemName          Silicon bands
SystemLabel         si_bands

NumberOfAtoms       2
NumberOfSpecies     1

%block ChemicalSpeciesLabel
  1  14  Si
%endblock ChemicalSpeciesLabel

LatticeConstant     5.43 Ang

%block LatticeVectors
  0.000  0.500  0.500
  0.500  0.000  0.500
  0.500  0.500  0.000
%endblock LatticeVectors

AtomicCoordinatesFormat  Fractional
%block AtomicCoordinatesAndAtomicSpecies
  0.00  0.00  0.00  1
  0.25  0.25  0.25  1
%endblock AtomicCoordinatesAndAtomicSpecies

PAO.BasisSize       DZP
MeshCutoff          300.0 Ry

XC.functional       GGA
XC.authors          PBE

DM.UseSaveDM        .true.
DM.NumberPulay      0

BandLinesScale      pi/a
%block BandLines
  1  0.000  0.000  0.000  \Gamma
 40  2.000  0.000  0.000  X
 40  2.000  1.000  0.000  W
 40  1.500  1.500  0.000  K
 40  0.000  0.000  0.000  \Gamma
 40  1.500  1.500  1.500  L
%endblock BandLines

COOP.Write          .true.

WriteEigenvalues    .true.
WriteBands          .true.
