&CONTROL
  calculation = 'scf'
  prefix = 'aluminum'
  outdir = './tmp/'
  pseudo_dir = './pseudo/'
  tprnfor = .true.
  tstress = .true.
/

&SYSTEM
  ibrav = 2
  celldm(1) = 7.65
  nat = 1
  ntyp = 1
  ecutwfc = 35.0
  ecutrho = 280.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.7
/

ATOMIC_SPECIES
  Al 26.982 Al.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (alat)
  Al 0.00 0.00 0.00

K_POINTS (automatic)
  12 12 12 0 0 0
